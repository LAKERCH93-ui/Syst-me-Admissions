function obtenirRessourcesEcole_(ecole) {
  const ressources = CONFIG.RESSOURCES_ECOLES[ecole];

  if (!ressources) {
    throw new Error(
      "Aucune ressource Drive/Docs n'est configurée pour l'école " +
      ecole +
      ". Ajoutez-la dans CONFIG.RESSOURCES_ECOLES."
    );
  }

  return ressources;
}

function obtenirRessourcesFlux_(ecole, typeAdmission) {
  const ressources = obtenirRessourcesEcole_(ecole);
  const flux = normaliserTexte_(typeAdmission);

  if (["NATIONAL", "INTERNATIONAL"].indexOf(flux) === -1) {
    throw new Error("Flux d'admission non reconnu : " + typeAdmission + ".");
  }

  const templateId = flux === "NATIONAL"
    ? ressources.TEMPLATE_NATIONAL_ID
    : ressources.TEMPLATE_INTERNATIONAL_ID;

  const dossierSpecifique = flux === "NATIONAL"
    ? ressources.DOSSIER_DRIVE_NATIONAL_ID
    : ressources.DOSSIER_DRIVE_INTERNATIONAL_ID;

  const nomExpediteurSpecifique = flux === "NATIONAL"
    ? ressources.NOM_EXPEDITEUR_NATIONAL
    : ressources.NOM_EXPEDITEUR_INTERNATIONAL;

  const replyToSpecifique = flux === "NATIONAL"
    ? ressources.REPLY_TO_NATIONAL
    : ressources.REPLY_TO_INTERNATIONAL;

  return {
    ECOLE: ecole,
    TYPE_ADMISSION: flux,
    TEMPLATE_ID: nettoyerValeur_(templateId),
    DOSSIER_DRIVE_ID: estIdConfigure_(dossierSpecifique)
      ? nettoyerValeur_(dossierSpecifique)
      : nettoyerValeur_(ressources.DOSSIER_DRIVE_ID),
    NOM_EXPEDITEUR: nettoyerValeur_(nomExpediteurSpecifique) ||
      nettoyerValeur_(ressources.NOM_EXPEDITEUR) ||
      ("Admissions " + ecole),
    REPLY_TO: nettoyerValeur_(replyToSpecifique) ||
      nettoyerValeur_(ressources.REPLY_TO)
  };
}

function estIdConfigure_(id) {
  const valeur = nettoyerValeur_(id);

  return Boolean(
    valeur &&
    valeur.indexOf("ID_") !== 0 &&
    valeur.indexOf("A_REMPLACER") === -1 &&
    valeur.indexOf("A_CONFIGURER") === -1
  );
}

function verifierIdConfigure_(id, nomParametre, ecole) {
  if (!estIdConfigure_(id)) {
    throw new Error(
      nomParametre +
      " n'est pas configuré pour " +
      ecole +
      ". Renseignez l'identifiant dans CONFIG.RESSOURCES_ECOLES."
    );
  }
}

