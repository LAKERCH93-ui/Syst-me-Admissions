  throw new Error(
    "Aucun fichier HTML compatible n'a été trouvé dans CE projet Apps Script.\n\n" +
    "Dans l'éditeur Apps Script :\n" +
    "1. Cliquez sur + puis HTML.\n" +
    "2. Donnez exactement le nom PanneauAdmissions, sans écrire .html.\n" +
    "3. Collez le contenu du fichier PanneauAdmissions.html.\n" +
    "4. Enregistrez puis actualisez le Google Sheet.\n\n" +
    "Noms testés : " + nomsPossibles.join(", ") + ".\n\n" +
    "Détails techniques :\n" + erreurs.join("\n")
