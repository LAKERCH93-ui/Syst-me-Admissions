function determinerEcole_(valeurEcole) {
  const valeurNormalisee = normaliserTexte_(valeurEcole);
  const ecole = CONFIG.ALIASES_ECOLES[valeurNormalisee] || valeurNormalisee;

  if (
    !CONFIG.ECOLES_MONO_CAMPUS[ecole] &&
    !CONFIG.ECOLES_MULTI_CAMPUS[ecole]
  ) {
    throw new Error(
      'École non reconnue : "' + valeurEcole + '". Ajoutez-la dans CONFIG.'
    );
  }

  return ecole;
}

function determinerCampus_(ecole, campusRecu) {
  const configMono = CONFIG.ECOLES_MONO_CAMPUS[ecole];

  if (configMono) {
    return configMono.CAMPUS_FIXE;
  }

  const configMulti = CONFIG.ECOLES_MULTI_CAMPUS[ecole];

  if (!configMulti) {
    throw new Error("Aucune configuration campus trouvée pour " + ecole + ".");
  }

  const campus = normaliserCampus_(campusRecu);

  if (!campus) {
    throw new Error(
      "Le campus est obligatoire pour l'école multi-campus " + ecole + "."
    );
  }

  if (configMulti.CAMPUS_AUTORISES.indexOf(campus) === -1) {
    throw new Error(
      "Campus invalide pour " + ecole +
      ". Campus autorisés : " + configMulti.CAMPUS_AUTORISES.join(", ") + "."
    );
  }

  return campus;
}

function determinerTypeAdmission_(paysResidence) {
  const pays = normaliserTexte_(paysResidence);

  if (!pays) {
    throw new Error(
      "Le pays de résidence est obligatoire pour déterminer le type d'admission."
    );
  }

  /**
   * RÈGLE MÉTIER :
   * - Résidence en France -> NATIONAL
   * - Résidence hors de France -> INTERNATIONAL
   */
  const valeursFrance = [
    "FRANCE",
    "FR",
    "FRA",
    "REPUBLIQUE FRANCAISE"
  ];

  return valeursFrance.indexOf(pays) !== -1
    ? "NATIONAL"
    : "INTERNATIONAL";
}

function obtenirIdSheet_(campus, typeAdmission) {
  const routeCampus = ROUTEUR_SHEETS[campus];

  if (!routeCampus) {
    throw new Error("Aucun routage Google Sheets configuré pour le campus " + campus + ".");
  }

  const spreadsheetId = routeCampus[typeAdmission];

  if (!spreadsheetId) {
    throw new Error(
      "Aucun Google Sheet configuré pour " + campus + " / " + typeAdmission + "."
    );
  }

  return spreadsheetId;
}

