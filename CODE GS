/**
 * Retourne les numéros de lignes correspondant à la sélection active.
 * La sélection d'une colonne entière est limitée aux lignes réellement
 * utilisées dans la feuille.
 */
function obtenirNumerosLignesSelectionnees_(feuille) {
  const rangeList = feuille.getActiveRangeList();
  const plages = rangeList
    ? rangeList.getRanges()
    : (feuille.getActiveRange() ? [feuille.getActiveRange()] : []);
  const derniereLigne = Math.max(feuille.getLastRow(), 1);
  const ensemble = {};

  plages.forEach(function(plage) {
    const debut = Math.max(2, plage.getRow());
    const fin = Math.min(
      derniereLigne,
      plage.getRow() + plage.getNumRows() - 1
    );

    for (let ligne = debut; ligne <= fin; ligne++) {
      ensemble[ligne] = true;
    }
  });

  return Object.keys(ensemble)
    .map(function(ligne) { return Number(ligne); })
    .sort(function(a, b) { return a - b; });
}

