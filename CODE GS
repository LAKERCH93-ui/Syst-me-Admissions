function obtenirContexteSelection_() {
  const classeur = SpreadsheetApp.getActiveSpreadsheet();
  const feuille = classeur.getActiveSheet();
  const plage = feuille.getActiveRange();

  if (!plage) {
    throw new Error("Sélectionnez une cellule sur la ligne du candidat.");
  }

  if (plage.getNumRows() !== 1 || plage.getRow() < 2) {
    throw new Error("Sélectionnez une seule ligne de candidat, sous l'en-tête.");
  }

  const ecole = determinerEcole_(feuille.getName());
  const contexteClasseur = identifierClasseurRoute_(classeur.getId());
  const candidat = lireCandidatLigne_(feuille, plage.getRow());
  const campus = normaliserCampus_(candidat.campus) ||
    (contexteClasseur ? contexteClasseur.campus : "");
  const typeAdmission = normaliserTexte_(candidat.type_admission) ||
    (contexteClasseur ? contexteClasseur.typeAdmission : "");

  if (!campus || !typeAdmission) {
    throw new Error(
      "Impossible d'identifier le campus ou le flux du classeur actif."
    );
  }

  return {
    classeur: classeur,
    feuille: feuille,
    ligne: plage.getRow(),
    ecole: ecole,
    campus: campus,
    typeAdmission: typeAdmission
  };
}

function identifierClasseurRoute_(spreadsheetId) {
  const campusList = Object.keys(ROUTEUR_SHEETS);

  for (let i = 0; i < campusList.length; i++) {
    const campus = campusList[i];
    const types = Object.keys(ROUTEUR_SHEETS[campus]);

    for (let j = 0; j < types.length; j++) {
      const typeAdmission = types[j];

      if (ROUTEUR_SHEETS[campus][typeAdmission] === spreadsheetId) {
        return {
          campus: campus,
          typeAdmission: typeAdmission
        };
      }
    }
  }

  return null;
}

function lireCandidatLigne_(feuille, numeroLigne) {
  const correspondance = synchroniserColonnes_(feuille);
  const ligne = feuille
    .getRange(numeroLigne, 1, 1, feuille.getLastColumn())
    .getDisplayValues()[0];

  const candidat = {};

  Object.keys(correspondance).forEach(function(cle) {
    candidat[cle] = nettoyerValeur_(
      ligne[correspondance[cle] - 1]
    );
  });

  candidat.niveau_academique = candidat.niveau_academique || candidat.cycle || "";
  candidat.domaine = candidat.domaine || "";
  candidat.rythme_academique = candidat.rythme_academique || candidat.rythme || "";

  return candidat;
}

function extraireLiensPiecesLigne_(candidat) {
  return {
    CV: candidat.lien_cv,
    DIPLOME: candidat.lien_diplome,
    PIECE_IDENTITE: candidat.lien_piece_identite,
    CARTE_VITALE: candidat.lien_carte_vitale,
    JUSTIFICATIF_HANDICAP: candidat.lien_justificatif_handicap
  };
}

function mettreAJourLigneParCles_(feuille, numeroLigne, valeurs) {
  const correspondance = synchroniserColonnes_(feuille);

  Object.keys(valeurs).forEach(function(cle) {
    const colonne = correspondance[cle];

    if (colonne) {
      feuille.getRange(numeroLigne, colonne).setValue(valeurs[cle]);
    }
  });

  SpreadsheetApp.flush();
}

