function enregistrerPiecesCandidat_(pieces, contexte) {
  if (!pieces || typeof pieces !== "object" || Array.isArray(pieces)) {
    return {};
  }

  const correspondance = {
    cv: "CV",
    CV: "CV",
    diplome: "DIPLOME",
    DIPLOME: "DIPLOME",
    piece_identite: "PIECE_IDENTITE",
    pieceIdentite: "PIECE_IDENTITE",
    identite: "PIECE_IDENTITE",
    PIECE_IDENTITE: "PIECE_IDENTITE",
    carte_vitale: "CARTE_VITALE",
    carteVitale: "CARTE_VITALE",
    vitale: "CARTE_VITALE",
    CARTE_VITALE: "CARTE_VITALE",
    justificatif_handicap: "JUSTIFICATIF_HANDICAP",
    rqth: "JUSTIFICATIF_HANDICAP",
    JUSTIFICATIF_HANDICAP: "JUSTIFICATIF_HANDICAP"
  };

  const codesRecus = Object.keys(pieces).filter(function(cle) {
    return correspondance[cle] && pieces[cle];
  });

  if (codesRecus.length === 0) {
    return {};
  }

  const dossierCandidat = obtenirDossierCandidat_(
    contexte.ecole,
    contexte.campus,
    contexte.typeAdmission,
    contexte.reference,
    contexte.nomComplet
  );

  const resultat = {};

  codesRecus.forEach(function(clePayload) {
    const code = correspondance[clePayload];
    const fichier = normaliserFichierPayload_(pieces[clePayload]);

    if (!fichier) return;

    const nomPropre = construireNomFichierPiece_(
      code,
      contexte.reference,
      fichier.nom
    );

    const octets = Utilities.base64Decode(fichier.base64);
    const blob = Utilities.newBlob(
      octets,
      fichier.mimeType || "application/octet-stream",
      nomPropre
    );

    const fichierDrive = dossierCandidat.createFile(blob);
    resultat[code] = fichierDrive.getUrl();
  });

  return resultat;
}

function normaliserFichierPayload_(fichier) {
  if (!fichier) return null;

  if (typeof fichier === "string") {
    return null;
  }

  const nom = nettoyerValeur_(
    fichier.nom || fichier.name || fichier.filename
  );
  const mimeType = nettoyerValeur_(
    fichier.mimeType || fichier.type || fichier.contentType
  );
  let base64 = nettoyerValeur_(
    fichier.base64 || fichier.data || fichier.contenu
  );

  if (!nom || !base64) return null;

  const marqueurBase64 = ";base64,";
  const position = base64.indexOf(marqueurBase64);

  if (position !== -1) {
    base64 = base64.substring(position + marqueurBase64.length);
  }

  return {
    nom: nom,
    mimeType: mimeType,
    base64: base64
  };
}

function construireNomFichierPiece_(code, reference, nomOriginal) {
  const extension = nomOriginal.indexOf(".") !== -1
    ? "." + nomOriginal.split(".").pop().replace(/[^a-zA-Z0-9]/g, "")
    : "";

  const libelle = (CONFIG.LIBELLES_PIECES[code] || code)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-zA-Z0-9]+/g, "_")
    .replace(/^_+|_+$/g, "")
    .toUpperCase();

  return reference + "_" + libelle + extension;
}

function obtenirDossierCandidat_(
  ecole,
  campus,
  typeAdmission,
  reference,
  nomComplet,
  ressourcesFlux
) {
  const ressources = ressourcesFlux || obtenirRessourcesFlux_(ecole, typeAdmission);
  verifierIdConfigure_(ressources.DOSSIER_DRIVE_ID, "DOSSIER_DRIVE_ID", ecole + " / " + typeAdmission);

  const racine = DriveApp.getFolderById(ressources.DOSSIER_DRIVE_ID);
  const annee = Utilities.formatDate(new Date(), CONFIG.FUSEAU_HORAIRE, "yyyy");
  const dossierAnnee = obtenirOuCreerDossier_(racine, "Admissions " + annee);
  const dossierCampus = obtenirOuCreerDossier_(dossierAnnee, campus);
  const dossierFlux = obtenirOuCreerDossier_(dossierCampus, typeAdmission);
  const nomDossier = reference + " - " + nettoyerNomDrive_(nomComplet);

  return obtenirOuCreerDossier_(dossierFlux, nomDossier);
}

function obtenirOuCreerDossier_(parent, nom) {
  const dossiers = parent.getFoldersByName(nom);
  return dossiers.hasNext() ? dossiers.next() : parent.createFolder(nom);
}

function nettoyerNomDrive_(valeur) {
  return nettoyerValeur_(valeur)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[\\/:*?"<>|#%{}~]/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .substring(0, 120) || "CANDIDAT";
}

function detecterPiecesManquantes_(typeAdmission, liens, handicap) {
  const obligations = (CONFIG.PIECES_OBLIGATOIRES[typeAdmission] || []).slice();

  if (normaliserTexte_(handicap) === "OUI") {
    obligations.push("JUSTIFICATIF_HANDICAP");
  }

  return obligations.filter(function(code) {
    return !nettoyerValeur_(liens[code]);
  });
}


