/**
 * Point d'entrée administratif unique.
 * NATIONAL      -> portail interne OTP + signature manuscrite.
 * INTERNATIONAL -> envoi direct du PDF par Gmail.
 */
function validerEtEnvoyerAdmissionSelectionnee() {
  const contexte = obtenirContexteSelection_();
  const flux = normaliserTexte_(contexte.typeAdmission);

  if (flux === "NATIONAL") {
    return validerEtEnvoyerAdmissionNationale_(contexte);
  }

  if (flux === "INTERNATIONAL") {
    return validerEtEnvoyerAdmissionInternationale_(contexte);
  }

  throw new Error(
    "Type d'admission non reconnu : " + (contexte.typeAdmission || "valeur vide") + "."
  );
}

function preparerAdmissionSelectionnee_(contexte) {
  const candidat = lireCandidatLigne_(contexte.feuille, contexte.ligne);
  const liens = extraireLiensPiecesLigne_(candidat);
  const manquantes = detecterPiecesManquantes_(
    contexte.typeAdmission,
    liens,
    candidat.handicap
  );

  if (manquantes.length > 0 && !CONFIG.AUTORISER_VALIDATION_DOSSIER_INCOMPLET) {
    throw new Error(
      "Validation bloquée. Pièces obligatoires manquantes : " +
      manquantes.map(function(code) {
        return CONFIG.LIBELLES_PIECES[code] || code;
      }).join(", ") + "."
    );
  }

  if (!emailValide_(candidat.email)) {
    throw new Error("L'adresse e-mail du candidat est absente ou invalide.");
  }

  const donneesRncp = obtenirDonneesRncp_(candidat);
  candidat.code_rncp = donneesRncp.code;
  candidat.niveau_academique = candidat.niveau_academique || candidat.cycle || "";
  candidat.domaine = candidat.domaine || "";
  candidat.rythme_academique = candidat.rythme_academique || candidat.rythme || "";

  const ressources = obtenirRessourcesEcole_(contexte.ecole);
  const ressourcesFlux = obtenirRessourcesFlux_(
    contexte.ecole,
    contexte.typeAdmission
  );
  verifierIdConfigure_(
    ressourcesFlux.TEMPLATE_ID,
    "TEMPLATE_" + contexte.typeAdmission + "_ID",
    contexte.ecole
  );
  verifierIdConfigure_(
    ressourcesFlux.DOSSIER_DRIVE_ID,
    "DOSSIER_DRIVE_ID",
    contexte.ecole + " / " + contexte.typeAdmission
  );

  const reference = candidat.reference_dossier ||
    genererReferenceDossier_(contexte.ecole, contexte.campus);

  const dossierCandidat = obtenirDossierCandidat_(
    contexte.ecole,
    contexte.campus,
    contexte.typeAdmission,
    reference,
    candidat.nom_complet,
    ressourcesFlux
  );

  const contexteLettre = {
    ecole: contexte.ecole,
    campus: contexte.campus,
    typeAdmission: contexte.typeAdmission,
    reference: reference,
    ressources: ressources,
    ressourcesFlux: ressourcesFlux,
    dossierCandidat: dossierCandidat
  };

  const lettre = genererLettreAdmission_(candidat, contexteLettre);

  return {
    candidat: candidat,
    ressources: ressources,
    ressourcesFlux: ressourcesFlux,
    reference: reference,
    dossierCandidat: dossierCandidat,
    contexteLettre: contexteLettre,
    lettre: lettre
  };
}

function verifierColonnesSignatureNationale_(feuille) {
  const colonnes = synchroniserColonnes_(feuille);
  const obligatoires = obtenirClesColonnesSignatureInterne_();
  const absentes = obligatoires.filter(function(cle) {
    return !colonnes[cle];
  });

  if (absentes.length > 0) {
    const titres = absentes.map(function(cle) {
      const champ = CHAMPS.filter(function(item) { return item.cle === cle; })[0];
      return champ ? champ.titre : cle;
    });
    throw new Error(
      "Colonnes de signature interne absentes dans l'onglet " + feuille.getName() +
      " : " + titres.join(", ") +
      ". Utilisez le menu « Installer les colonnes — onglet actif »."
    );
  }
}

function validerEtEnvoyerAdmissionNationale_(contexte) {
  verifierColonnesSignatureNationale_(contexte.feuille);
  const candidatAvant = lireCandidatLigne_(contexte.feuille, contexte.ligne);
  const statutAvant = normaliserStatutSignature_(candidatAvant.statut_signature);

  if (["EN ATTENTE DE SIGNATURE", "CONSULTÉ", "FINALISATION EN COURS", "SIGNÉ"].indexOf(statutAvant) !== -1) {
    throw new Error(
      "Une demande de signature existe déjà pour ce dossier. " +
      "Utilisez la fonction de relance ou révoquez le lien existant."
    );
  }

  const preparation = preparerAdmissionSelectionnee_(contexte);
  const maintenant = formaterDate_(new Date());
  const validateur = Session.getActiveUser().getEmail() || "Utilisateur Apps Script";
  const demande = creerDemandeSignatureInterne_(
    contexte,
    preparation.candidat,
    preparation.reference,
    preparation.lettre
  );

  mettreAJourLigneParCles_(contexte.feuille, contexte.ligne, {
    reference_dossier: preparation.reference,
    statut: "ADMIS - EN ATTENTE DE SIGNATURE",
    motif_non_conformite: "",
    pieces_manquantes: "",
    lien_pdf_lettre: preparation.lettre.pdfFile.getUrl(),
    code_rncp: preparation.candidat.code_rncp,
    date_decision: maintenant,
    valide_par: validateur,
    statut_signature: "EN ATTENTE DE SIGNATURE",
    id_demande_signature: demande.idDemande,
    id_document_signature: preparation.lettre.documentFile.getId(),
    id_signataire: demande.idSignataire,
    id_fichier_pdf_original: preparation.lettre.pdfFile.getId(),
    date_envoi_signature: maintenant,
    date_signature: "",
    date_consultation_signature: "",
    expiration_signature: demande.expirationIso,
    lien_signature: demande.lienSignature,
    token_signature_hash: demande.tokenHash,
    otp_signature_hash: "",
    otp_expiration: "",
    otp_tentatives: 0,
    date_derniere_otp: "",
    lien_pdf_signe: "",
    lien_dossier_preuve: "",
    niveau_signature: "INTERNE - OTP EMAIL + SIGNATURE MANUSCRITE",
    consentement_signature: "",
    user_agent_signature: "",
    empreinte_pdf_original: demande.empreintePdfOriginal,
    empreinte_pdf_signe: "",
    id_fichier_signature_image: "",
    id_evenement_signature: "",
    derniere_relance_signature: "",
    erreur_signature: ""
  });

  try {
    envoyerEmailDemandeSignatureInterne_(
      preparation.candidat,
      {
        ecole: contexte.ecole,
        campus: contexte.campus,
        reference: preparation.reference,
        nomExpediteur: preparation.ressourcesFlux.NOM_EXPEDITEUR,
        replyTo: preparation.ressourcesFlux.REPLY_TO
      },
      demande.lienSignature,
      preparation.lettre.pdfBlob
    );
  } catch (erreurEmail) {
    mettreAJourLigneParCles_(contexte.feuille, contexte.ligne, {
      erreur_signature: "Lien créé, mais e-mail non envoyé : " + erreurEmail.message
    });
    throw new Error(
      "La demande a été créée, mais l'e-mail n'a pas pu être envoyé : " +
      erreurEmail.message
    );
  }

  return {
    success: true,
    mode_traitement: "SIGNATURE_INTERNE_OTP",
    message: "La lettre et le lien privé de signature ont été envoyés.",
    reference_dossier: preparation.reference,
    pdf_url: preparation.lettre.pdfFile.getUrl(),
    email: preparation.candidat.email,
    code_rncp: preparation.candidat.code_rncp,
    id_demande_signature: demande.idDemande,
    signature_link: demande.lienSignature,
    statut_signature: "EN ATTENTE DE SIGNATURE"
  };
}

