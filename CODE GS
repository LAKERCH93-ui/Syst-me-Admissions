/**
 * Injecte une candidature depuis un autre fichier Apps Script,
 * un import CSV, une interface interne ou une fonction métier.
 *
 * Exemple :
 * const resultat = enregistrerCandidatInterne({
 *   ecole: "ILMIS",
 *   campus: "TORCY",
 *   pays_residence: "France",
 *   nom: "DUPONT",
 *   prenom: "Alice",
 *   email: "alice.dupont@example.com",
 *   formation: "Bachelor Commerce International"
 * });
 *
 * @param {Object} donneesEtudiant
 * @return {Object}
 */
function enregistrerCandidatInterne(donneesEtudiant) {
  if (!donneesEtudiant || typeof donneesEtudiant !== "object") {
    throw new Error("donneesEtudiant doit être un objet JavaScript.");
  }

  const copie = JSON.parse(JSON.stringify(donneesEtudiant));
  return traiterCandidature_(copie, "INTERNE");
}

// ============================================================================
// 6. TRAITEMENT CENTRAL
// ============================================================================

/**
 * Toute candidature, qu'elle soit WEB, INTERNE ou TEST,
 * passe obligatoirement par cette fonction.
 *
 * @param {Object} payload
 * @param {String} sourceDefaut
 * @return {Object}
 */
function traiterCandidature_(payload, sourceDefaut) {
  const verrou = LockService.getScriptLock();

  if (!verrou.tryLock(30000)) {
    throw new Error("Le serveur traite déjà plusieurs candidatures. Réessayez dans quelques secondes.");
  }

  try {
    validerCleApi_(payload);
    const donnees = normaliserDonneesCandidat_(payload, sourceDefaut);
    validerDonneesObligatoires_(donnees);

    const ecole = determinerEcole_(donnees.ecole);
    const campus = determinerCampus_(ecole, donnees.campus);
    const typeAdmission = determinerTypeAdmission_(donnees.pays_residence);
    const spreadsheetId = obtenirIdSheet_(campus, typeAdmission);

    const classeur = SpreadsheetApp.openById(spreadsheetId);
    const feuille = obtenirOuCreerOnglet_(classeur, ecole);
    const correspondanceColonnes = synchroniserColonnes_(feuille);

    if (
      CONFIG.BLOQUER_DOUBLONS_EMAIL &&
      !donnees.autoriser_doublon &&
      estDoublonEmail_(feuille, correspondanceColonnes.email, donnees.email)
    ) {
      throw new Error(
        "Une candidature existe déjà avec cette adresse e-mail dans cette école, sur ce campus et dans ce flux."
      );
    }

    const reference = genererReferenceDossier_(ecole, campus);
    const maintenant = new Date();

    const liensExistants = extraireLiensPiecesPayload_(payload);
    const liensCrees = enregistrerPiecesCandidat_(
      payload.pieces || payload.fichiers || payload.documents || {},
      {
        ecole: ecole,
        campus: campus,
        typeAdmission: typeAdmission,
        reference: reference,
        nomComplet: donnees.nom_complet
      }
    );
    const liensPieces = Object.assign({}, liensExistants, liensCrees);
    const piecesManquantes = detecterPiecesManquantes_(
      typeAdmission,
      liensPieces,
      donnees.handicap
    );
    const statutInitial = donnees.statut || (
      piecesManquantes.length > 0
        ? "DOSSIER INCOMPLET - À CONTRÔLER"
        : "DOSSIER COMPLET - À VALIDER"
    );

    const valeurs = {
      date_soumission: formaterDate_(maintenant),
      reference_dossier: reference,
      source: donnees.source,
      type_admission: typeAdmission,
      ecole: ecole,
      campus: campus,
      nom_complet: donnees.nom_complet,
      nom: donnees.nom,
      prenom: donnees.prenom,
      date_naissance: donnees.date_naissance,
      lieu_naissance: donnees.lieu_naissance,
      pays_residence: donnees.pays_residence,
      ville: donnees.ville,
      adresse: donnees.adresse,
      telephone: donnees.telephone,
      telephone_proche: donnees.telephone_proche,
      email: donnees.email,
      cycle: donnees.cycle,
      niveau_academique: donnees.niveau_academique,
      domaine: donnees.domaine,
      formation: donnees.formation,
      code_rncp: donnees.code_rncp,
      rythme: donnees.rythme,
      financement: donnees.financement,
      handicap: donnees.handicap,
      motif_non_conformite: "",
      pieces_manquantes: piecesManquantes
        .map(function(code) { return CONFIG.LIBELLES_PIECES[code] || code; })
        .join(", "),
      lien_cv: liensPieces.CV || "",
      lien_diplome: liensPieces.DIPLOME || "",
      lien_piece_identite: liensPieces.PIECE_IDENTITE || "",
      lien_carte_vitale: liensPieces.CARTE_VITALE || "",
      lien_justificatif_handicap: liensPieces.JUSTIFICATIF_HANDICAP || "",
      lien_pdf_lettre: "",
      date_decision: "",
      date_email: "",
      valide_par: "",
      statut: statutInitial,
      donnees_brutes: JSON.stringify(payload)
    };

    const numeroLigne = insererLigne_(feuille, correspondanceColonnes, valeurs);

    SpreadsheetApp.flush();

    return {
      reference_dossier: reference,
      ecole: ecole,
      campus: campus,
      type_admission: typeAdmission,
      spreadsheet_id: spreadsheetId,
      onglet: feuille.getName(),
      ligne: numeroLigne,
      pieces_manquantes: piecesManquantes,
      date_soumission: valeurs.date_soumission
    };
  } finally {
    verrou.releaseLock();
  }
}

