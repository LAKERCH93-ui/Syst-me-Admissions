function secretSignatureEstInvalide_(secret) {
  const valeur = nettoyerValeur_(secret);

  return (
    !valeur ||
    valeur.length < 32 ||
    /^https?:\/\//i.test(valeur) ||
    /script\.google\.com\/macros\/s\//i.test(valeur)
  );
}

function genererNouveauSecretSignature_() {
  return [
    Utilities.getUuid(),
    Utilities.getUuid(),
    Utilities.getUuid(),
    new Date().getTime()
  ].join("|");
}

function obtenirOuCreerSecretSignature_() {
  const proprietes = PropertiesService.getScriptProperties();
  let secret = nettoyerValeur_(
    proprietes.getProperty("SIGNATURE_SECRET")
  );

  // Correction automatique :
  // SIGNATURE_SECRET ne doit jamais contenir l'URL du portail.
  if (secretSignatureEstInvalide_(secret)) {
    secret = genererNouveauSecretSignature_();

    proprietes.setProperty(
      "SIGNATURE_SECRET",
      secret
    );
  }

  return secret;
}

function normaliserUrlWebAppSignature_(url) {
  const valeur = String(url || "")
    .trim()
    .split("#")[0]
    .split("?")[0]
    .replace(/\/+$/g, "");

  if (!valeur) {
    return "";
  }

  const modele =
    /^https:\/\/script\.google\.com\/macros\/s\/[^/?#]+\/exec$/i;

  return modele.test(valeur) ? valeur : "";
}

function obtenirUrlWebAppSignature_() {
  const proprietes =
    PropertiesService.getScriptProperties();

  const urlProprieteBrute = nettoyerValeur_(
    proprietes.getProperty("SIGNATURE_WEBAPP_URL")
  );

  const urlPropriete =
    normaliserUrlWebAppSignature_(urlProprieteBrute);

  // IMPORTANT :
  // L'URL saisie explicitement par l'administrateur est prioritaire.
  // ScriptApp.getService().getUrl() peut encore désigner un ancien
  // déploiement lorsqu'il existe plusieurs déploiements.
  if (urlPropriete) {
    return urlPropriete;
  }

  const urlServiceBrute = nettoyerValeur_(
    ScriptApp.getService().getUrl()
  );

  const urlService =
    normaliserUrlWebAppSignature_(urlServiceBrute);

  if (urlService) {
    return urlService;
  }

  throw new Error(
    "Aucune URL /exec valide n'est configurée.\n\n" +
    "Dans Google Sheets, utilisez :\n" +
    "ADMISSIONS HYBRIDES V11 > Configurer l’URL du portail.\n\n" +
    "Collez l'URL exacte du nouveau déploiement terminée par /exec."
  );
}

function construireLienSignatureInterne_(token) {
  const jeton = nettoyerValeur_(token);

  if (!jeton) {
    throw new Error("Le jeton de signature est absent.");
  }

  return (
    obtenirUrlWebAppSignature_() +
    "?action=signer&token=" +
    encodeURIComponent(jeton)
  );
}

