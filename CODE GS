function normaliserDonneesCandidat_(payload, sourceDefaut) {
  const indicatifTel = nettoyerValeur_(premiereValeur_(payload, [
    "indicatif_tel",
    "indicatifTelephone",
    "country_code"
  ]));

  const numeroTel = nettoyerValeur_(premiereValeur_(payload, [
    "telephone",
    "tel",
    "phone"
  ]));

  const indicatifProche = nettoyerValeur_(premiereValeur_(payload, [
    "indicatif_proche",
    "indicatifTelephoneProche"
  ]));

  const numeroProche = nettoyerValeur_(premiereValeur_(payload, [
    "telephone_proche",
    "telephoneProche",
    "urgence"
  ]));

  const nom = nettoyerValeur_(premiereValeur_(payload, [
    "nom",
    "last_name",
    "lastname"
  ])).toUpperCase();

  const prenom = nettoyerValeur_(premiereValeur_(payload, [
    "prenom",
    "prénom",
    "first_name",
    "firstname"
  ]));

  const nomCompletRecu = nettoyerValeur_(premiereValeur_(payload, [
    "nom_complet",
    "nom_prenoms",
    "nomPrenoms"
  ]));

  const financementFrance = nettoyerValeur_(premiereValeur_(payload, [
    "financement_fr",
    "financementFrance"
  ]));

  const financementInternational = nettoyerValeur_(premiereValeur_(payload, [
    "financement_hors_fr",
    "financementInternational"
  ]));

  return {
    ecole: nettoyerValeur_(premiereValeur_(payload, ["ecole", "école", "school"])),
    campus: nettoyerValeur_(premiereValeur_(payload, ["campus", "site"])),
    pays_residence: nettoyerValeur_(premiereValeur_(payload, [
      "pays_residence",
      "paysResidence",
      "pays"
    ])),
    nom: nom,
    prenom: prenom,
    nom_complet: nomCompletRecu || [nom, prenom].filter(Boolean).join(" ").trim(),
    date_naissance: nettoyerValeur_(premiereValeur_(payload, [
      "ddn",
      "date_naissance",
      "dateNaissance"
    ])),
    lieu_naissance: nettoyerValeur_(premiereValeur_(payload, [
      "ldn",
      "lieu_naissance",
      "lieuNaissance"
    ])),
    ville: nettoyerValeur_(premiereValeur_(payload, [
      "ville",
      "ville_residence",
      "villeResidence"
    ])),
    adresse: nettoyerValeur_(premiereValeur_(payload, [
      "adresse",
      "adresse_postale",
      "address"
    ])),
    telephone: joindreTelephone_(indicatifTel, numeroTel),
    telephone_proche: joindreTelephone_(indicatifProche, numeroProche),
    email: nettoyerValeur_(premiereValeur_(payload, [
      "email",
      "adresse_email",
      "mail"
    ])).toLowerCase(),
    cycle: nettoyerValeur_(premiereValeur_(payload, [
      "cycle",
      "type_cycle",
      "typeCycle"
    ])),
    niveau_academique: nettoyerValeur_(premiereValeur_(payload, [
      "niveau_academique",
      "niveauAcademique",
      "niveau_etude",
      "niveauEtude"
    ])),
    domaine: nettoyerValeur_(premiereValeur_(payload, [
      "domaine",
      "specialite",
      "spécialité",
      "niveau"
    ])),
    formation: nettoyerValeur_(premiereValeur_(payload, [
      "formation",
      "programme"
    ])),
    code_rncp: nettoyerValeur_(premiereValeur_(payload, [
      "code_rncp",
      "codeRncp",
      "rncp"
    ])),
    rythme: nettoyerValeur_(premiereValeur_(payload, [
      "rythme_academique",
      "rythmeAcademique",
      "rythme",
      "modalite",
      "modalité"
    ])),
    financement: nettoyerValeur_(
      premiereValeur_(payload, ["financement"]) ||
      financementFrance ||
      financementInternational
    ),
    handicap: nettoyerValeur_(premiereValeur_(payload, [
      "handicap",
      "situation_handicap",
      "situationHandicap"
    ])),
    statut: nettoyerValeur_(premiereValeur_(payload, ["statut", "status"])),
    source: nettoyerValeur_(premiereValeur_(payload, ["source"])) || sourceDefaut || "INCONNUE",
    autoriser_doublon: payload.autoriser_doublon === true || payload.autoriserDoublon === true
  };
}

function validerDonneesObligatoires_(donnees) {
  const erreurs = [];

  if (!donnees.ecole) erreurs.push("école");
  if (!donnees.pays_residence) erreurs.push("pays de résidence");
  if (!donnees.nom_complet) erreurs.push("nom et prénom");
  if (!donnees.email) erreurs.push("adresse e-mail");
  if (!donnees.cycle) erreurs.push("cycle");
  if (!donnees.niveau_academique) erreurs.push("niveau académique");
  if (!donnees.domaine) erreurs.push("domaine");
  if (!donnees.formation) erreurs.push("formation");
  if (!donnees.rythme) erreurs.push("rythme académique");

  if (donnees.email && !emailValide_(donnees.email)) {
    erreurs.push("adresse e-mail invalide");
  }

  if (erreurs.length > 0) {
    throw new Error("Données obligatoires absentes ou invalides : " + erreurs.join(", ") + ".");
  }
}

function validerCleApi_(payload) {
  if (!CONFIG.EXIGER_CLE_API) return;

  const cleConfiguree = PropertiesService
    .getScriptProperties()
    .getProperty("ADMISSIONS_API_KEY");

  if (!cleConfiguree) {
    throw new Error("La sécurité par clé API est activée, mais ADMISSIONS_API_KEY n'est pas configurée.");
  }

  const cleRecue = nettoyerValeur_(payload.api_key || payload.apiKey);

  if (!cleRecue || cleRecue !== cleConfiguree) {
    throw new Error("Clé API absente ou invalide.");
  }
}

