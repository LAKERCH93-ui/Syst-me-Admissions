function lireCorpsRequete_(e) {
  if (!e) {
    throw new Error("Événement HTTP absent.");
  }

  const contenu = e.postData && e.postData.contents
    ? e.postData.contents.trim()
    : "";

  if (contenu) {
    try {
      const json = JSON.parse(contenu);

      if (!json || typeof json !== "object" || Array.isArray(json)) {
        throw new Error("Le JSON doit représenter un objet.");
      }

      return json;
    } catch (erreurJson) {
      // Compatibilité avec un corps de type data={...}
      if (e.parameter && e.parameter.data) {
        try {
          return JSON.parse(e.parameter.data);
        } catch (erreurData) {
          throw new Error("Le paramètre data ne contient pas un JSON valide.");
        }
      }

      throw new Error("Corps JSON invalide : " + erreurJson.message);
    }
  }

  // Compatibilité avec application/x-www-form-urlencoded.
  if (e.parameter && Object.keys(e.parameter).length > 0) {
    return Object.assign({}, e.parameter);
  }

  throw new Error("Aucune donnée n'a été reçue.");
}

/**
 * Rend le backend compatible avec les deux formats suivants :
 * 1. { donnees: {...}, fichiers: {...} }  <- format actuel des frontends
 * 2. { nom: ..., ecole: ..., pieces: ... } <- format aplati historique
 */
function normaliserEnveloppeFrontend_(corps) {
  if (!corps || typeof corps !== "object" || Array.isArray(corps)) {
    throw new Error("Le corps de la requête doit être un objet JSON.");
  }

  const donnees = corps.donnees &&
    typeof corps.donnees === "object" &&
    !Array.isArray(corps.donnees)
      ? corps.donnees
      : {};

  // On conserve aussi les éventuels paramètres placés à la racine
  // (api_key, autoriser_doublon, source, etc.).
  const payload = Object.assign({}, corps, donnees);

  const fichiers = corps.fichiers ||
    corps.pieces ||
    corps.documents ||
    donnees.fichiers ||
    donnees.pieces ||
    donnees.documents ||
    {};

  payload.pieces = fichiers;

  delete payload.donnees;
  delete payload.fichiers;
  delete payload.documents;

  return payload;
}

function creerReponseJson_(objet) {
  return ContentService
    .createTextOutput(JSON.stringify(objet))
    .setMimeType(ContentService.MimeType.JSON);
}

