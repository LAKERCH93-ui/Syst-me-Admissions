function creerDemandeSignatureInterne_(contexte, candidat, reference, lettre) {
  if (!CONFIG.SIGNATURE_INTERNE || CONFIG.SIGNATURE_INTERNE.ACTIVE !== true) {
    throw new Error("Le module de signature interne est désactivé.");
  }

  if (normaliserTexte_(contexte.typeAdmission) !== "NATIONAL") {
    throw new Error("La signature interne est réservée au flux NATIONAL.");
  }

  if (!emailValide_(candidat.email)) {
    throw new Error("L'adresse e-mail du candidat est invalide.");
  }

  const expiration = new Date();
  expiration.setDate(
    expiration.getDate() + CONFIG.SIGNATURE_INTERNE.VALIDITE_LIEN_JOURS
  );

  const token = creerJetonSignatureInterne_({
    spreadsheetId: contexte.classeur.getId(),
    sheetId: contexte.feuille.getSheetId(),
    ligne: contexte.ligne,
    reference: reference,
    expirationMs: expiration.getTime()
  });

  // Le lien utilise exclusivement l'URL /exec configurée.
  const lien = construireLienSignatureInterne_(token);

  return {
    idDemande: "SIG-" + Utilities.getUuid(),
    idSignataire: "USR-" + Utilities.getUuid(),
    tokenHash: hacherTexteSha256_(token),
    lienSignature: lien,
    expirationIso: expiration.toISOString(),
    empreintePdfOriginal: hacherBlobSha256_(lettre.pdfBlob)
  };
}

function creerJetonSignatureInterne_(parametres) {
  const payload = {
    v: 1,
    sid: parametres.spreadsheetId,
    gid: Number(parametres.sheetId),
    row: Number(parametres.ligne),
    ref: String(parametres.reference || ""),
    exp: Number(parametres.expirationMs),
    nonce: Utilities.getUuid()
  };

  const partieDonnees = encoderBase64UrlTexte_(
    JSON.stringify(payload)
  );
  const partieSignature = signerHmacBase64Url_(
    partieDonnees,
    obtenirOuCreerSecretSignature_()
  );

  return partieDonnees + "." + partieSignature;
}

function verifierJetonSignatureInterne_(token) {
  const valeur = nettoyerValeur_(token);
  const parties = valeur.split(".");

  if (parties.length !== 2) {
    throw new Error("Lien de signature invalide.");
  }

  const signatureAttendue = signerHmacBase64Url_(
    parties[0],
    obtenirOuCreerSecretSignature_()
  );

  if (!comparaisonConstante_(parties[1], signatureAttendue)) {
    throw new Error("Lien de signature falsifié ou invalide.");
  }

  let payload;

  try {
    payload = JSON.parse(decoderBase64UrlTexte_(parties[0]));
  } catch (_) {
    throw new Error("Le lien de signature est illisible.");
  }

  if (
    !payload ||
    payload.v !== 1 ||
    !payload.sid ||
    !payload.gid ||
    !payload.ref ||
    !payload.exp
  ) {
    throw new Error("Le lien de signature est incomplet.");
  }

  if (Date.now() > Number(payload.exp)) {
    throw new Error("Ce lien de signature a expiré.");
  }

  return payload;
}

function obtenirContexteDepuisJetonSignature_(token) {
  const payload = verifierJetonSignatureInterne_(token);
  const classeur = SpreadsheetApp.openById(payload.sid);
  const feuille = obtenirFeuilleParId_(classeur, Number(payload.gid));

  if (!feuille) {
    throw new Error("L'onglet associé à cette signature n'existe plus.");
  }

  let ligne = Number(payload.row);
  let candidat = null;

  if (ligne >= 2 && ligne <= feuille.getLastRow()) {
    candidat = lireCandidatLigne_(feuille, ligne);
  }

  if (
    !candidat ||
    nettoyerValeur_(candidat.reference_dossier) !== nettoyerValeur_(payload.ref)
  ) {
    ligne = trouverLigneParReference_(feuille, payload.ref);

    if (!ligne) {
      throw new Error("Le dossier associé au lien est introuvable.");
    }

    candidat = lireCandidatLigne_(feuille, ligne);
  }

  if (
    !comparaisonConstante_(
      nettoyerValeur_(candidat.token_signature_hash),
      hacherTexteSha256_(token)
    )
  ) {
    throw new Error("Ce lien a été révoqué ou remplacé.");
  }

  const route = identifierClasseurRoute_(classeur.getId());
  const campus = normaliserCampus_(candidat.campus) ||
    (route ? route.campus : "");
  const typeAdmission = normaliserTexte_(candidat.type_admission) ||
    (route ? route.typeAdmission : "");

  if (typeAdmission !== "NATIONAL") {
    throw new Error("Ce dossier n'utilise pas le parcours de signature nationale.");
  }

  return {
    payload: payload,
    classeur: classeur,
    feuille: feuille,
    ligne: ligne,
    candidat: candidat,
    ecole: determinerEcole_(feuille.getName()),
    campus: campus,
    typeAdmission: typeAdmission
  };
}

function obtenirFeuilleParId_(classeur, sheetId) {
  const feuilles = classeur.getSheets();

  for (let i = 0; i < feuilles.length; i++) {
    if (Number(feuilles[i].getSheetId()) === Number(sheetId)) {
      return feuilles[i];
    }
  }

  return null;
}

function trouverLigneParReference_(feuille, reference) {
  const colonnes = synchroniserColonnes_(feuille);

  if (!colonnes.reference_dossier || feuille.getLastRow() < 2) {
    return 0;
  }

  const plage = feuille.getRange(
    2,
    colonnes.reference_dossier,
    feuille.getLastRow() - 1,
    1
  );
  const cellule = plage.createTextFinder(String(reference))
    .matchEntireCell(true)
    .findNext();

  return cellule ? cellule.getRow() : 0;
}

function chargerDossierSignature(token) {
  try {
    const contexte = obtenirContexteDepuisJetonSignature_(token);
    contexteFinalisation = contexte;
    const candidat = contexte.candidat;
    const statut = normaliserStatutSignature_(candidat.statut_signature);

    if (!candidat.date_consultation_signature) {
      mettreAJourLigneParCles_(contexte.feuille, contexte.ligne, {
        date_consultation_signature: formaterDate_(new Date()),
        statut_signature: statut === "EN ATTENTE DE SIGNATURE"
          ? "CONSULTÉ"
          : candidat.statut_signature
      });
    }

    return {
      success: true,
      dossier: {
        reference: candidat.reference_dossier,
        nomComplet: candidat.nom_complet ||
          [candidat.nom, candidat.prenom].filter(Boolean).join(" "),
        ecole: contexte.ecole,
        campus: contexte.campus,
        formation: candidat.formation,
        emailMasque: masquerEmail_(candidat.email),
        statut: statut,
        dateExpiration: formaterDateHeureLisible_(new Date(Number(contexte.payload.exp))),
        dejaSigne: statut === "SIGNÉ",
        consentement: CONFIG.SIGNATURE_INTERNE.CONSENTEMENT_TEXTE
      }
    };
  } catch (erreur) {
    return {
      success: false,
      message: erreur.message
    };
  }
}

function envoyerOtpSignature(token) {
  const contexte = obtenirContexteDepuisJetonSignature_(token);
  const candidat = contexte.candidat;
  const statut = normaliserStatutSignature_(candidat.statut_signature);

  if (statut === "SIGNÉ") {
    throw new Error("Ce document a déjà été signé.");
  }

  if (statut === "RÉVOQUÉ") {
    throw new Error("Cette demande a été révoquée.");
  }

  const dernierEnvoi = lireDateIso_(candidat.date_derniere_otp);

  if (dernierEnvoi) {
    const secondesEcoulees = Math.floor(
      (Date.now() - dernierEnvoi.getTime()) / 1000
    );

    if (secondesEcoulees < CONFIG.SIGNATURE_INTERNE.DELAI_RENVOI_OTP_SECONDES) {
      throw new Error(
        "Veuillez patienter " +
        (CONFIG.SIGNATURE_INTERNE.DELAI_RENVOI_OTP_SECONDES - secondesEcoulees) +
        " seconde(s) avant de demander un nouveau code."
      );
    }
  }

  const code = genererCodeOtp6Chiffres_();
  const expiration = new Date(
    Date.now() + CONFIG.SIGNATURE_INTERNE.VALIDITE_OTP_MINUTES * 60 * 1000
  );
  const tokenHash = hacherTexteSha256_(token);
  const otpHash = hacherTexteSha256_(
    obtenirOuCreerSecretSignature_() + "|" + tokenHash + "|" + code
  );

  mettreAJourLigneParCles_(contexte.feuille, contexte.ligne, {
    otp_signature_hash: otpHash,
    otp_expiration: expiration.toISOString(),
    otp_tentatives: 0,
    date_derniere_otp: new Date().toISOString(),
    erreur_signature: ""
  });

  try {
    envoyerEmailOtpSignature_(
      candidat,
      {
        ecole: contexte.ecole,
        reference: candidat.reference_dossier
      },
      code
    );
  } catch (erreurEmail) {
    mettreAJourLigneParCles_(contexte.feuille, contexte.ligne, {
      otp_signature_hash: "",
      otp_expiration: "",
      erreur_signature: "OTP non envoyé : " + erreurEmail.message
    });
    throw erreurEmail;
  }

  return {
    success: true,
    emailMasque: masquerEmail_(candidat.email),
    validiteMinutes: CONFIG.SIGNATURE_INTERNE.VALIDITE_OTP_MINUTES
  };
}

function finaliserSignatureEtudiant(donnees) {
  const verrou = LockService.getScriptLock();
  verrou.waitLock(30000);
  let finalisationCommencee = false;
  let contexteFinalisation = null;

  try {
    const token = nettoyerValeur_(donnees && donnees.token);
    const codeOtp = nettoyerValeur_(donnees && donnees.otp);
    const signatureDataUrl = nettoyerValeur_(
      donnees && donnees.signatureDataUrl
    );
    const consentementAccepte = Boolean(
      donnees && donnees.consentementAccepte
    );
    const userAgent = tronquerTexteInterne_(
      nettoyerValeur_(donnees && donnees.userAgent),
      700
    );

    if (!token) {
      throw new Error("Le jeton de signature est absent.");
    }
    if (!consentementAccepte) {
      throw new Error("Le consentement doit être accepté.");
    }
    if (!signatureDataUrl) {
      throw new Error("La signature manuscrite est absente.");
    }

    const contexte = obtenirContexteDepuisJetonSignature_(token);
    const candidat = contexte.candidat;
    const statut = normaliserStatutSignature_(candidat.statut_signature);

    if (statut === "SIGNÉ") {
      return {
        success: true,
        dejaSigne: true,
        reference: candidat.reference_dossier,
        message: "Cette lettre a déjà été signée."
      };
    }

    verifierOtpSignatureInterne_(contexte, token, codeOtp);

    const signatureBlob = decoderSignatureDataUrl_(signatureDataUrl);
    const dossier = obtenirDossierParentDocument_(
      candidat.id_document_signature
    );
    const idEvenement = nettoyerValeur_(candidat.id_evenement_signature) ||
      "EVT-" + Utilities.getUuid();
    const dateSignature = new Date();
    const empreinteOriginale = nettoyerValeur_(
      candidat.empreinte_pdf_original
    ) || obtenirEmpreintePdfOriginale_(candidat);

    mettreAJourLigneParCles_(contexte.feuille, contexte.ligne, {
      statut_signature: "FINALISATION EN COURS",
      id_evenement_signature: idEvenement,
      erreur_signature: ""
    });
    finalisationCommencee = true;

    const fichierSignature = dossier.createFile(
      signatureBlob.setName(
        "SIGNATURE_" +
        nettoyerNomDrive_(candidat.reference_dossier) +
        ".png"
      )
    );

    insererSignatureDansDocument_(
      candidat.id_document_signature,
      signatureBlob,
      {
        candidat: candidat,
        ecole: contexte.ecole,
        campus: contexte.campus,
        dateSignature: dateSignature,
        idEvenement: idEvenement,
        empreinteOriginale: empreinteOriginale,
        userAgent: userAgent
      }
    );

    const nomPdfSigne =
      "LETTRE_ADMISSION_SIGNEE_" +
      nettoyerNomDrive_(candidat.reference_dossier) +
      ".pdf";

    const pdfSigneBlob = exporterDocumentGoogleEnPdfV4_(
      candidat.id_document_signature,
      nomPdfSigne
    );
    const fichierPdfSigne = dossier.createFile(pdfSigneBlob);
    const empreinteSignee = hacherBlobSha256_(pdfSigneBlob);

    const preuve = creerDossierPreuveSignature_(
      dossier,
      {
        candidat: candidat,
        ecole: contexte.ecole,
        campus: contexte.campus,
        dateSignature: dateSignature,
        idEvenement: idEvenement,
        empreinteOriginale: empreinteOriginale,
        empreinteSignee: empreinteSignee,
        consentement: CONFIG.SIGNATURE_INTERNE.CONSENTEMENT_TEXTE,
        userAgent: userAgent,
        idFichierPdfSigne: fichierPdfSigne.getId(),
        idFichierSignature: fichierSignature.getId()
      }
    );

    const dateTexte = formaterDate_(dateSignature);

    mettreAJourLigneParCles_(contexte.feuille, contexte.ligne, {
      statut_signature: "SIGNÉ",
      statut: "ADMIS - LETTRE SIGNÉE",
      date_signature: dateTexte,
      date_email: dateTexte,
      lien_pdf_signe: fichierPdfSigne.getUrl(),
      lien_dossier_preuve: preuve.pdfFile.getUrl(),
      consentement_signature: CONFIG.SIGNATURE_INTERNE.CONSENTEMENT_TEXTE,
      user_agent_signature: userAgent,
      empreinte_pdf_original: empreinteOriginale,
      empreinte_pdf_signe: empreinteSignee,
      id_fichier_signature_image: fichierSignature.getId(),
      otp_signature_hash: "",
      otp_expiration: "",
      erreur_signature: ""
    });

    let avertissementEmail = "";

    try {
      envoyerEmailFinalSignature_(
        candidat,
        {
          ecole: contexte.ecole,
          campus: contexte.campus,
          reference: candidat.reference_dossier
        },
        pdfSigneBlob,
        preuve.pdfBlob
      );
    } catch (erreurEmail) {
      avertissementEmail =
        " La signature est enregistrée, mais l'e-mail final n'a pas pu être envoyé.";
      mettreAJourLigneParCles_(contexte.feuille, contexte.ligne, {
        erreur_signature: "PDF signé créé, e-mail final non envoyé : " +
          erreurEmail.message
      });
    }

    return {
      success: true,
      reference: candidat.reference_dossier,
      message:
        "Votre signature a été enregistrée. Le PDF signé a été archivé." +
        avertissementEmail
    };
  } catch (erreur) {
    if (finalisationCommencee && contexteFinalisation) {
      try {
        mettreAJourLigneParCles_(
          contexteFinalisation.feuille,
          contexteFinalisation.ligne,
          {
            statut_signature: "ERREUR DE FINALISATION",
            erreur_signature: erreur.message
          }
        );
      } catch (_) {
        // Ne pas masquer l'erreur principale.
      }
    }

    throw erreur;
  } finally {
    verrou.releaseLock();
  }
}

function verifierOtpSignatureInterne_(contexte, token, codeOtp) {
  const candidat = lireCandidatLigne_(contexte.feuille, contexte.ligne);
  const tentatives = Number(candidat.otp_tentatives || 0);

  if (!candidat.otp_signature_hash || !candidat.otp_expiration) {
    throw new Error("Demandez d'abord un code de vérification.");
  }

  if (tentatives >= CONFIG.SIGNATURE_INTERNE.MAX_TENTATIVES_OTP) {
    throw new Error(
      "Nombre maximal de tentatives atteint. Demandez un nouveau code."
    );
  }

  const expiration = lireDateIso_(candidat.otp_expiration);

  if (!expiration || Date.now() > expiration.getTime()) {
    throw new Error("Le code de vérification a expiré.");
  }

  if (!/^[0-9]{6}$/.test(codeOtp)) {
    throw new Error("Le code doit contenir exactement 6 chiffres.");
  }

  const hashRecu = hacherTexteSha256_(
    obtenirOuCreerSecretSignature_() +
    "|" +
    hacherTexteSha256_(token) +
    "|" +
    codeOtp
  );

  if (
    !comparaisonConstante_(
      nettoyerValeur_(candidat.otp_signature_hash),
      hashRecu
    )
  ) {
    mettreAJourLigneParCles_(contexte.feuille, contexte.ligne, {
      otp_tentatives: tentatives + 1
    });

    throw new Error(
      "Code incorrect. Tentative " +
      (tentatives + 1) +
      "/" +
      CONFIG.SIGNATURE_INTERNE.MAX_TENTATIVES_OTP +
      "."
    );
  }
}

function insererSignatureDansDocument_(documentId, signatureBlob, donnees) {
  if (!documentId) {
    throw new Error("L'identifiant du Google Docs original est absent.");
  }

  const document = DocumentApp.openById(documentId);
  const body = document.getBody();
  const texteComplet = body.getText();

  if (
    donnees.idEvenement &&
    texteComplet.indexOf(donnees.idEvenement) !== -1
  ) {
    document.saveAndClose();
    return;
  }

  const signatureInseree = insererImageSurBalise_(
    body,
    "{{SIGNATURE_CANDIDAT}}",
    signatureBlob
  );

  remplacerBaliseSimpleDocument_(
    body,
    "{{DATE_SIGNATURE}}",
    formaterDateHeureLisible_(donnees.dateSignature)
  );
  remplacerBaliseSimpleDocument_(
    body,
    "{{ID_SIGNATURE}}",
    donnees.idEvenement
  );

  if (!signatureInseree) {
    body.appendPageBreak();
    body.appendParagraph("SIGNATURE DU CANDIDAT")
      .setHeading(DocumentApp.ParagraphHeading.HEADING2);
    body.appendImage(signatureBlob).setWidth(240).setHeight(95);
    body.appendParagraph(
      "Signé électroniquement le " +
      formaterDateHeureLisible_(donnees.dateSignature)
    );
  }

  body.appendPageBreak();
  body.appendParagraph("CERTIFICAT DE SIGNATURE INTERNE")
    .setHeading(DocumentApp.ParagraphHeading.HEADING1);
  body.appendParagraph(
    "Ce certificat complète la lettre d'admission et retrace le parcours de validation."
  );

  const table = body.appendTable([
    ["Référence du dossier", nettoyerValeur_(donnees.candidat.reference_dossier)],
    ["Candidat", nettoyerValeur_(donnees.candidat.nom_complet)],
    ["Adresse e-mail", nettoyerValeur_(donnees.candidat.email)],
    ["École", nettoyerValeur_(donnees.ecole)],
    ["Campus", nettoyerValeur_(donnees.campus)],
    ["Date et heure", formaterDateHeureLisible_(donnees.dateSignature)],
    ["Identifiant de l'événement", nettoyerValeur_(donnees.idEvenement)],
    ["Empreinte SHA-256 du PDF original", nettoyerValeur_(donnees.empreinteOriginale)],
    ["Navigateur déclaré", nettoyerValeur_(donnees.userAgent)]
  ]);

  table.getRow(0).getCell(0).setBackgroundColor("#e5e7eb");

  body.appendParagraph("Signature manuscrite capturée :");
  body.appendImage(signatureBlob).setWidth(240).setHeight(95);
  body.appendParagraph("Consentement enregistré :");
  body.appendParagraph(CONFIG.SIGNATURE_INTERNE.CONSENTEMENT_TEXTE);

  document.saveAndClose();
  Utilities.sleep(1800);
}

function insererImageSurBalise_(body, balise, blob) {
  const resultat = body.findText(
    echapperExpressionReguliere_(balise)
  );

  if (!resultat) {
    return false;
  }

  const texte = resultat.getElement().asText();

  if (resultat.isPartial()) {
    texte.deleteText(
      resultat.getStartOffset(),
      resultat.getEndOffsetInclusive()
    );
  } else {
    texte.setText("");
  }

  const parent = texte.getParent();

  if (parent && typeof parent.appendInlineImage === "function") {
    parent.appendInlineImage(blob).setWidth(240).setHeight(95);
    return true;
  }

  return false;
}

function remplacerBaliseSimpleDocument_(body, balise, valeur) {
  body.replaceText(
    echapperExpressionReguliere_(balise),
    nettoyerValeur_(valeur)
  );
}

function creerDossierPreuveSignature_(dossier, donnees) {
  const reference = nettoyerNomDrive_(
    donnees.candidat.reference_dossier
  );
  const preuveObjet = {
    version: "1.0",
    type: "SIGNATURE_INTERNE_OTP_EMAIL_CANVAS",
    id_evenement: donnees.idEvenement,
    reference_dossier: donnees.candidat.reference_dossier,
    candidat: {
      nom_complet: donnees.candidat.nom_complet,
      email: donnees.candidat.email
    },
    ecole: donnees.ecole,
    campus: donnees.campus,
    date_signature_iso: donnees.dateSignature.toISOString(),
    date_signature_locale: formaterDateHeureLisible_(donnees.dateSignature),
    consentement: donnees.consentement,
    user_agent: donnees.userAgent,
    empreinte_sha256_pdf_original: donnees.empreinteOriginale,
    empreinte_sha256_pdf_signe: donnees.empreinteSignee,
    id_fichier_pdf_signe: donnees.idFichierPdfSigne,
    id_fichier_signature: donnees.idFichierSignature
  };

  const jsonBlob = Utilities.newBlob(
    JSON.stringify(preuveObjet, null, 2),
    "application/json",
    "PREUVE_SIGNATURE_" + reference + ".json"
  );
  const jsonFile = dossier.createFile(jsonBlob);

  const document = DocumentApp.create(
    "PREUVE_SIGNATURE_" + reference
  );
  const fichierDocument = DriveApp.getFileById(document.getId());
  fichierDocument.moveTo(dossier);

  const body = document.getBody();
  body.appendParagraph("DOSSIER DE PREUVE DE SIGNATURE")
    .setHeading(DocumentApp.ParagraphHeading.HEADING1);
  body.appendParagraph(
    "Signature interne avec vérification par code à usage unique envoyé par e-mail."
  );
  body.appendTable([
    ["Identifiant de l'événement", donnees.idEvenement],
    ["Référence du dossier", donnees.candidat.reference_dossier],
    ["Candidat", donnees.candidat.nom_complet],
    ["Adresse e-mail", donnees.candidat.email],
    ["École", donnees.ecole],
    ["Campus", donnees.campus],
    ["Date et heure", formaterDateHeureLisible_(donnees.dateSignature)],
    ["Mode de vérification", "Code OTP envoyé par e-mail"],
    ["Empreinte SHA-256 du PDF original", donnees.empreinteOriginale],
    ["Empreinte SHA-256 du PDF signé", donnees.empreinteSignee],
    ["Navigateur déclaré", donnees.userAgent]
  ]);
  body.appendParagraph("Consentement :")
    .setHeading(DocumentApp.ParagraphHeading.HEADING2);
  body.appendParagraph(donnees.consentement);
  document.saveAndClose();

  Utilities.sleep(1000);

  const nomPdf = "PREUVE_SIGNATURE_" + reference + ".pdf";
  const pdfBlob = exporterDocumentGoogleEnPdfV4_(
    document.getId(),
    nomPdf
  );
  const pdfFile = dossier.createFile(pdfBlob);

  try {
    fichierDocument.setTrashed(true);
  } catch (_) {
    // Le PDF et le JSON restent les pièces de preuve principales.
  }

  return {
    jsonFile: jsonFile,
    pdfFile: pdfFile,
    pdfBlob: pdfBlob
  };
}

function obtenirDossierParentDocument_(documentId) {
  const fichier = DriveApp.getFileById(documentId);
  const parents = fichier.getParents();

  if (!parents.hasNext()) {
    throw new Error("Le dossier du document d'admission est introuvable.");
  }

  return parents.next();
}

function obtenirEmpreintePdfOriginale_(candidat) {
  const id = nettoyerValeur_(candidat.id_fichier_pdf_original) ||
    extraireIdDriveDepuisUrlInterne_(candidat.lien_pdf_lettre);

  if (!id) {
    throw new Error("Le PDF original est introuvable.");
  }

  return hacherBlobSha256_(DriveApp.getFileById(id).getBlob());
}

function extraireIdDriveDepuisUrlInterne_(url) {
  const correspondance = String(url || "").match(/[-\w]{25,}/);
  return correspondance ? correspondance[0] : "";
}

