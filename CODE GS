/**
 * Vérification de disponibilité de l'API.
 * Ouvrir l'URL /exec dans un navigateur pour contrôler le déploiement.
 */
function doGet(e) {
  try {
    const action = normaliserTexte_(
      e && e.parameter ? e.parameter.action : ""
    );

    if (action === "SIGNER") {
      const template = HtmlService.createTemplateFromFile(
        CONFIG.SIGNATURE_INTERNE.NOM_FICHIER_HTML
      );

      template.tokenInitial = nettoyerValeur_(
        e && e.parameter ? e.parameter.token : ""
      );

      return template
        .evaluate()
        .setTitle("Signature de votre lettre d'admission")
        .setXFrameOptionsMode(
          HtmlService.XFrameOptionsMode.DEFAULT
        );
    }

    const html =
      '<!doctype html><html lang="fr"><head>' +
      '<meta charset="utf-8">' +
      '<meta name="viewport" content="width=device-width,initial-scale=1">' +
      '<title>Portail Admissions</title>' +
      '<style>' +
      'body{font-family:Arial,sans-serif;background:#f4f7fb;margin:0;padding:32px;color:#17324d}' +
      '.card{max-width:680px;margin:60px auto;background:#fff;border-radius:18px;padding:32px;box-shadow:0 12px 35px rgba(17,45,78,.12)}' +
      '.ok{display:inline-block;background:#e8f7ee;color:#166534;padding:8px 12px;border-radius:999px;font-weight:700}' +
      'code{word-break:break-all;background:#f2f4f7;padding:3px 6px;border-radius:5px}' +
      '</style></head><body><main class="card">' +
      '<span class="ok">SERVICE OPÉRATIONNEL</span>' +
      '<h1>Portail Admissions</h1>' +
      '<p>Le déploiement Apps Script répond correctement.</p>' +
      '<p>Version : <strong>' + echapperHtml_(CONFIG.VERSION) + '</strong></p>' +
      '<p>Le portail de signature utilise une adresse du type :</p>' +
      '<code>/exec?action=signer&amp;token=...</code>' +
      '</main></body></html>';

    return HtmlService
      .createHtmlOutput(html)
      .setTitle("Portail Admissions");
  } catch (erreur) {
    return HtmlService
      .createHtmlOutput(
        "<h2>Erreur du portail</h2><pre>" +
        echapperHtml_(
          erreur && erreur.message
            ? erreur.message
            : "Erreur inconnue"
        ) +
        "</pre>"
      )
      .setTitle("Erreur du portail");
  }
}

/**
 * Réception d'une candidature envoyée par un formulaire externe.
 *
 * Corps recommandé :
 * Content-Type: text/plain;charset=utf-8
 * JSON.stringify(donneesEtudiant)
 */
function doPost(e) {
  try {
    // Les six frontends envoient actuellement :
    // { donnees: {...}, fichiers: {...} }
    // Cette fonction accepte également un objet déjà aplati.
    const corpsRecu = lireCorpsRequete_(e);
    const donneesEtudiant = normaliserEnveloppeFrontend_(corpsRecu);
    const resultat = traiterCandidature_(donneesEtudiant, "WEB");

    // La référence est renvoyée à la fois dans data et à la racine afin de
    // rester compatible avec toutes les versions des frontends.
    return creerReponseJson_({
      success: true,
      result: "success",
      message: "Candidature enregistrée.",
      reference: resultat.reference_dossier,
      numero: resultat.reference_dossier,
      numeroDossier: resultat.reference_dossier,
      data: resultat
    });
  } catch (erreur) {
    console.error(erreur && erreur.stack ? erreur.stack : erreur);

    return creerReponseJson_({
      success: false,
      result: "error",
      message: erreur && erreur.message
        ? erreur.message
        : "Erreur inconnue pendant l'enregistrement."
    });
  }
}

