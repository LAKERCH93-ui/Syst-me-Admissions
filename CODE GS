      candidat: {
        ligne: contexte.ligne,
        ecole: contexte.ecole,
        campus: contexte.campus,
        typeAdmission: contexte.typeAdmission,
        reference: candidat.reference_dossier,
        nomComplet: candidat.nom_complet || [candidat.nom, candidat.prenom].filter(Boolean).join(" "),
        email: candidat.email,
        formation: candidat.formation,
        niveauAcademique: candidat.niveau_academique,
        domaine: candidat.domaine,
        rythmeAcademique: candidat.rythme_academique,
        codeRncp: candidat.code_rncp || "",
        statut: candidat.statut,
        statutSignature: candidat.statut_signature || "",
        idDemandeSignature: candidat.id_demande_signature || "",
        dateSignature: candidat.date_signature || "",
        lienPdfSigne: candidat.lien_pdf_signe || "",
        modeTraitement: normaliserTexte_(contexte.typeAdmission) === "NATIONAL"
          ? "SIGNATURE_INTERNE_OTP"
          : "ENVOI_DIRECT_EMAIL",
        libelleAction: normaliserTexte_(contexte.typeAdmission) === "NATIONAL"
          ? "Générer et envoyer pour signature"
          : "Générer et envoyer la lettre",
        pieces: pieces
      }
    };
  } catch (erreur) {
    return {
      success: false,
      message: erreur.message
    };
  }
}

function construireEtatPieces_(typeAdmission, liens, handicap) {
  const obligatoires = (CONFIG.PIECES_OBLIGATOIRES[typeAdmission] || []).slice();

  if (normaliserTexte_(handicap) === "OUI") {
    obligatoires.push("JUSTIFICATIF_HANDICAP");
  }

  const ordre = [
    "CV",
    "DIPLOME",
    "PIECE_IDENTITE",
    "CARTE_VITALE",
    "JUSTIFICATIF_HANDICAP"
  ];

  return ordre.map(function(code) {
    return {
      code: code,
      libelle: CONFIG.LIBELLES_PIECES[code] || code,
      obligatoire: obligatoires.indexOf(code) !== -1,
      present: Boolean(nettoyerValeur_(liens[code])),
      lien: liens[code] || ""
    };
  }).filter(function(piece) {
    return piece.obligatoire || piece.present;
  });
}

