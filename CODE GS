function regenererEtRenvoyerLienSignatureSelectionnee() {
  const ui = SpreadsheetApp.getUi();

  try {
    const contexte = obtenirContexteSelection_();

    if (normaliserTexte_(contexte.typeAdmission) !== "NATIONAL") {
      throw new Error(
        "Cette action est réservée aux admissions nationales."
      );
    }

    const candidat = lireCandidatLigne_(
      contexte.feuille,
      contexte.ligne
    );
    const statut = normaliserStatutSignature_(
      candidat.statut_signature
    );

    if (statut === "SIGNÉ") {
      throw new Error("Cette lettre est déjà signée.");
    }

    if (!candidat.reference_dossier) {
      throw new Error("La référence du dossier est absente.");
    }

    if (!emailValide_(candidat.email)) {
      throw new Error("L'adresse e-mail du candidat est invalide.");
    }

    // La génération n'est plus bloquée par un auto-test HTTP.
    const expiration = new Date();
    expiration.setDate(
      expiration.getDate() +
      CONFIG.SIGNATURE_INTERNE.VALIDITE_LIEN_JOURS
    );

    const token = creerJetonSignatureInterne_({
      spreadsheetId: contexte.classeur.getId(),
      sheetId: contexte.feuille.getSheetId(),
      ligne: contexte.ligne,
      reference: candidat.reference_dossier,
      expirationMs: expiration.getTime()
    });

    const lien = construireLienSignatureInterne_(token);

    const idPdf =
      nettoyerValeur_(candidat.id_fichier_pdf_original) ||
      extraireIdDriveDepuisUrlInterne_(
        candidat.lien_pdf_lettre
      );

    if (!idPdf) {
      throw new Error(
        "Le PDF original de la lettre est introuvable."
      );
    }

    const fichierPdf = DriveApp.getFileById(idPdf);
    const ressourcesFlux = obtenirRessourcesFlux_(
      contexte.ecole,
      contexte.typeAdmission
    );

    // La nouvelle empreinte invalide immédiatement tous les anciens liens.
    mettreAJourLigneParCles_(
      contexte.feuille,
      contexte.ligne,
      {
        statut_signature: "EN ATTENTE DE SIGNATURE",
        statut: "ADMIS - EN ATTENTE DE SIGNATURE",
        lien_signature: lien,
        token_signature_hash: hacherTexteSha256_(token),
        expiration_signature: expiration.toISOString(),
        otp_signature_hash: "",
        otp_expiration: "",
        otp_tentatives: 0,
        date_derniere_otp: "",
        derniere_relance_signature: formaterDate_(new Date()),
        erreur_signature: ""
      }
    );

    envoyerEmailDemandeSignatureInterne_(
      candidat,
      {
        ecole: contexte.ecole,
        campus: contexte.campus,
        reference: candidat.reference_dossier,
        nomExpediteur: ressourcesFlux.NOM_EXPEDITEUR,
        replyTo: ressourcesFlux.REPLY_TO
      },
      lien,
      fichierPdf.getBlob()
    );

    ui.alert(
      "Nouveau lien envoyé",
      "Un nouveau lien Apps Script /exec a été créé.\n\n" +
      "L'ancien lien a été invalidé.\n\n" +
      "Adresse : " + candidat.email +
      "\n\nLien :\n" + lien,
      ui.ButtonSet.OK
    );
  } catch (erreur) {
    ui.alert("Erreur", erreur.message, ui.ButtonSet.OK);
  }
}

