function normaliserStatutSignature_(statut) {
  const valeur = normaliserTexte_(statut);
  const alias = {
    "SIGNE": "SIGNÉ",
    "SIGNED": "SIGNÉ",
    "EN ATTENTE": "EN ATTENTE DE SIGNATURE",
    "CONSULTE": "CONSULTÉ",
    "REVOQUE": "RÉVOQUÉ"
  };

  return alias[valeur] || valeur;
}

function genererCodeOtp6Chiffres_() {
  const source = Utilities.getUuid().replace(/-/g, "");
  const nombre = parseInt(source.substring(0, 12), 16) % 1000000;
  return String(nombre).padStart(6, "0");
}

function hacherTexteSha256_(texte) {
  const octets = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    String(texte || ""),
    Utilities.Charset.UTF_8
  );
  return octetsVersHex_(octets);
}

function hacherBlobSha256_(blob) {
  if (!blob || typeof blob.getBytes !== "function") {
    throw new Error("Impossible de calculer l'empreinte d'un fichier absent.");
  }

  const octets = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    blob.getBytes()
  );
  return octetsVersHex_(octets);
}

function octetsVersHex_(octets) {
  return octets.map(function(octet) {
    const valeur = (octet + 256) % 256;
    return ("0" + valeur.toString(16)).slice(-2);
  }).join("");
}

function signerHmacBase64Url_(message, secret) {
  const octets = Utilities.computeHmacSha256Signature(
    String(message || ""),
    String(secret || ""),
    Utilities.Charset.UTF_8
  );

  return Utilities.base64EncodeWebSafe(octets)
    .replace(/=+$/g, "");
}

function encoderBase64UrlTexte_(texte) {
  return Utilities.base64EncodeWebSafe(
    String(texte || ""),
    Utilities.Charset.UTF_8
  ).replace(/=+$/g, "");
}

function decoderBase64UrlTexte_(texte) {
  let valeur = String(texte || "");

  while (valeur.length % 4 !== 0) {
    valeur += "=";
  }

  const octets = Utilities.base64DecodeWebSafe(valeur);
  return Utilities.newBlob(octets).getDataAsString("UTF-8");
}

function comparaisonConstante_(a, b) {
  const gauche = String(a || "");
  const droite = String(b || "");
  let difference = gauche.length ^ droite.length;
  const longueur = Math.max(gauche.length, droite.length);

  for (let i = 0; i < longueur; i++) {
    difference |=
      (gauche.charCodeAt(i) || 0) ^
      (droite.charCodeAt(i) || 0);
  }

  return difference === 0;
}

function decoderSignatureDataUrl_(dataUrl) {
  const correspondance = String(dataUrl || "").match(
    /^data:image\/png;base64,([A-Za-z0-9+/=\s]+)$/
  );

  if (!correspondance) {
    throw new Error("Format de signature invalide. Une image PNG est requise.");
  }

  const octets = Utilities.base64Decode(
    correspondance[1].replace(/\s/g, "")
  );

  if (
    octets.length < 100 ||
    octets.length > CONFIG.SIGNATURE_INTERNE.TAILLE_MAX_SIGNATURE_OCTETS
  ) {
    throw new Error(
      "La taille de la signature est invalide ou dépasse la limite autorisée."
    );
  }

  return Utilities.newBlob(
    octets,
    "image/png",
    "signature.png"
  );
}

function masquerEmail_(email) {
  const valeur = String(email || "");
  const parties = valeur.split("@");

  if (parties.length !== 2) {
    return valeur;
  }

  const local = parties[0];
  const visible = local.substring(0, Math.min(2, local.length));

  return visible +
    "*".repeat(Math.max(2, local.length - visible.length)) +
    "@" +
    parties[1];
}

function lireDateIso_(valeur) {
  const date = new Date(String(valeur || ""));
  return isNaN(date.getTime()) ? null : date;
}

function formaterDateHeureLisible_(date) {
  return Utilities.formatDate(
    date,
    CONFIG.FUSEAU_HORAIRE,
    "dd/MM/yyyy 'à' HH:mm:ss"
  );
}

function tronquerTexteInterne_(texte, longueurMax) {
  const valeur = String(texte || "");
  return valeur.length > longueurMax
    ? valeur.substring(0, longueurMax)
    : valeur;
}


