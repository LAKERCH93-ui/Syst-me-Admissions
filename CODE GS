        "dd/MM/yyyy"
      )
    };

    etape = "remplacement des balises";
    remplacerDansDocument_(document, remplacements);

    etape = "enregistrement du Google Docs";
    document.saveAndClose();

    // saveAndClose() force les modifications en attente. On laisse ensuite
    // le temps au service Docs de rendre la nouvelle version exportable.
    Utilities.sleep(2500);

    etape = "conversion du Google Docs en PDF";
    const pdfConverti = exporterDocumentGoogleEnPdfV4_(
      documentId,
      nomFichier + ".pdf"
    );

    etape = "enregistrement du PDF dans Drive";
    const pdfFile = executerAvecRelance_(
      function() {
        const fichierPdf = contexte.dossierCandidat.createFile(
          pdfConverti.copyBlob().setName(nomFichier + ".pdf")
        );
        fichierPdf.getSize();
        return fichierPdf;
      },
      4,
      1000,
      "Enregistrement du PDF dans Drive"
    );

    // On ne transmet pas à Gmail le blob de conversion, qui peut rester lié
    // au document source. On relit le vrai fichier PDF binaire créé dans Drive.
    etape = "lecture binaire du PDF enregistré";
    const pdfBlobEmail = executerAvecRelance_(
      function() {
        const fichierPdfActualise = DriveApp.getFileById(pdfFile.getId());
        const blob = fichierPdfActualise.getBlob()
          .setContentType(MimeType.PDF)
          .setName(nomFichier + ".pdf");

        if (!blob || blob.getBytes().length === 0) {
          throw new Error("Le fichier PDF enregistré est vide.");
        }

        return blob;
      },
      5,
      1000,
      "Lecture du PDF enregistré"
    );

    // La copie Google Docs est supprimée seulement après création et relecture
    // réussies du PDF. Elle reste disponible en cas de diagnostic.
    if (!CONFIG.CONSERVER_DOCUMENT_GOOGLE && contexte.typeAdmission !== "NATIONAL") {
      try {
        copie.setTrashed(true);
      } catch (erreurSuppression) {
        console.warn(
          "La copie Google Docs n'a pas pu être supprimée : " +
          erreurSuppression.message
        );
      }
    }

    return {
      documentFile: copie,
      pdfFile: pdfFile,
      pdfBlob: pdfBlobEmail
    };
  } catch (erreur) {
    const idCopie = copie ? copie.getId() : "aucune copie créée";
    const urlCopie = copie
      ? "https://docs.google.com/document/d/" + copie.getId() + "/edit"
      : "aucune";

    throw new Error(
      "Échec à l'étape « " + etape + " » : " +
      erreur.message +
      ". ID de la copie : " + idCopie +
      ". URL de contrôle : " + urlCopie
    );
  }
}

/**
 * Exécute une opération susceptible d'échouer temporairement et la relance.
 * Ceci corrige les délais de synchronisation entre DriveApp et DocumentApp.
 */
function executerAvecRelance_(operation, nombreTentatives, attenteInitialeMs, libelle) {
  let derniereErreur = null;

  for (let tentative = 1; tentative <= nombreTentatives; tentative++) {
    try {
      return operation();
    } catch (erreur) {
      derniereErreur = erreur;
      console.warn(
        libelle + " — tentative " + tentative + "/" + nombreTentatives +
        " : " + erreur.message
      );

      if (tentative < nombreTentatives) {
        Utilities.sleep(attenteInitialeMs * tentative);
      }
    }
  }

  throw new Error(
    libelle + " impossible après " + nombreTentatives +
    " tentative(s) : " +
    (derniereErreur ? derniereErreur.message : "erreur inconnue")
  );
}

/**
 * Exporte un Google Docs en PDF avec trois méthodes successives.
 * 1. DocumentApp.getAs() ; 2. DriveApp.getAs() ; 3. URL d'export Docs.
 * La troisième méthode utilise le jeton OAuth du script, sans compte de
 * service et sans configuration manuelle dans Google Cloud.
 */
function exporterDocumentGoogleEnPdfV4_(documentId, nomPdf) {
  const erreurs = [];

  // Méthode 1 : export depuis le service Google Docs.
  try {
    return executerAvecRelance_(
      function() {
        const document = DocumentApp.openById(documentId);
        const blob = document.getAs(MimeType.PDF).setName(nomPdf);

        if (!blob || blob.getBytes().length === 0) {
          throw new Error("DocumentApp a retourné un PDF vide.");
        }

        return blob;
      },
      3,
      1500,
      "Export PDF par DocumentApp"
    );
  } catch (erreurDocumentApp) {
    erreurs.push("DocumentApp : " + erreurDocumentApp.message);
  }

  // Méthode 2 : export depuis le fichier Drive.
  try {
    return executerAvecRelance_(
      function() {
        const fichier = DriveApp.getFileById(documentId);
        const blob = fichier.getAs(MimeType.PDF).setName(nomPdf);

        if (!blob || blob.getBytes().length === 0) {
          throw new Error("DriveApp a retourné un PDF vide.");
        }

        return blob;
      },
      3,
      1800,
      "Export PDF par DriveApp"
    );
  } catch (erreurDriveApp) {
    erreurs.push("DriveApp : " + erreurDriveApp.message);
  }

  // Méthode 3 : téléchargement de l'export PDF via le serveur Google Docs.
  try {
    return executerAvecRelance_(
      function() {
        const url =
          "https://docs.google.com/document/d/" +
          encodeURIComponent(documentId) +
          "/export?format=pdf";

        const reponse = UrlFetchApp.fetch(url, {
          method: "get",
          headers: {
            Authorization: "Bearer " + ScriptApp.getOAuthToken()
          },
          followRedirects: true,
          muteHttpExceptions: true
        });

        const code = reponse.getResponseCode();
        const typeContenu = String(
          reponse.getHeaders()["Content-Type"] ||
          reponse.getHeaders()["content-type"] ||
          ""
        ).toLowerCase();

        if (code !== 200) {
          throw new Error(
            "Réponse HTTP " + code + " : " +
            reponse.getContentText().substring(0, 300)
          );
        }

        const blob = reponse.getBlob()
          .setContentType(MimeType.PDF)
          .setName(nomPdf);

        if (!blob || blob.getBytes().length === 0) {
          throw new Error("L'URL d'export a retourné un fichier vide.");
        }

        if (typeContenu && typeContenu.indexOf("pdf") === -1) {
          throw new Error(
            "Le serveur a renvoyé « " + typeContenu + " » au lieu d'un PDF."
          );
        }

        return blob;
      },
      4,
      2000,
      "Export PDF par URL Google Docs"
    );
  } catch (erreurUrl) {
    erreurs.push("URL Google Docs : " + erreurUrl.message);
  }

  throw new Error(
    "Les trois méthodes de conversion ont échoué. " + erreurs.join(" | ")
  );
}


function remplacerDansDocument_(document, remplacements) {
  const elements = [
    document.getBody(),
    document.getHeader(),
    document.getFooter()
  ].filter(function(element) {
    return element !== null;
  });

  Object.keys(remplacements).forEach(function(balise) {
    const valeur = nettoyerValeur_(remplacements[balise]);

    elements.forEach(function(element) {
      element.replaceText(echapperExpressionReguliere_(balise), valeur);
    });
  });
}

