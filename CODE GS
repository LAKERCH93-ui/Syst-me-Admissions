function premiereValeur_(objet, cles) {
  for (let i = 0; i < cles.length; i++) {
    const valeur = objet[cles[i]];

    if (valeur !== undefined && valeur !== null && String(valeur).trim() !== "") {
      return valeur;
    }
  }

  return "";
}

function nettoyerValeur_(valeur) {
  if (valeur === undefined || valeur === null) return "";
  return String(valeur).trim();
}

function joindreTelephone_(indicatif, numero) {
  const code = nettoyerValeur_(indicatif);
  const tel = nettoyerValeur_(numero);

  if (!code) return tel;
  if (!tel) return code;

  return (code + " " + tel).replace(/\s+/g, " ").trim();
}

function normaliserTexte_(valeur) {
  return nettoyerValeur_(valeur)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\s+/g, " ")
    .toUpperCase();
}

function normaliserEntete_(valeur) {
  return normaliserTexte_(valeur)
    .replace(/[^A-Z0-9]+/g, " ")
    .trim();
}

function normaliserCampus_(valeur) {
  const campus = normaliserTexte_(valeur);

  // Valeurs acceptées :
  // TORCY, Campus Torcy, Campus de Torcy
  // EVRY, Évry, Campus d'Évry
  // LYON, Campus Lyon, Campus de Lyon
  if (campus.indexOf("TORCY") !== -1) return "TORCY";
  if (campus.indexOf("EVRY") !== -1) return "EVRY";
  if (campus.indexOf("LYON") !== -1) return "LYON";
  if (campus.indexOf("NOISIEL") !== -1 || campus.indexOf("MARNE LA VALLEE") !== -1) return "NOISIEL";

  return "";
}

function emailValide_(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

function genererReferenceDossier_(ecole, campus) {
  const prefixeEcole = normaliserTexte_(ecole)
    .replace(/[^A-Z0-9]/g, "")
    .substring(0, 5);

  const prefixeCampus = campus.substring(0, 3);
  const date = Utilities.formatDate(new Date(), CONFIG.FUSEAU_HORAIRE, "yyyyMMdd");
  const suffixe = Utilities.getUuid()
    .replace(/-/g, "")
    .substring(0, 6)
    .toUpperCase();

  return prefixeEcole + "-" + prefixeCampus + "-" + date + "-" + suffixe;
}

function formaterDate_(date) {
  return Utilities.formatDate(
    date,
    CONFIG.FUSEAU_HORAIRE,
    "dd/MM/yyyy HH:mm:ss"
  );
}
