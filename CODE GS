function obtenirOuCreerOnglet_(classeur, ecole) {
  const variantesParEcole = {
    "DCG FORMATIONS": ["DCG FORMATIONS", "DCG FORMATION", "DCG"],
    "ESMAS": ["ESMAS", "ESMASS"],
    "MLV BS": ["MLV BS", "MLV-BS", "MLV BUSINESS SCHOOL", "MARNE LA VALLEE BUSINESS SCHOOL"],
    "MLV BTS": ["MLV BTS", "MARNE LA VALLEE BTS"],
    "EVRY BS": ["EVRY BS", "EVRY BUSINESS SCHOOL"]
  };
  const variantes = variantesParEcole[ecole] || [ecole];

  for (let i = 0; i < variantes.length; i++) {
    const feuille = classeur.getSheetByName(variantes[i]);
    if (feuille) return feuille;
  }

  throw new Error(
    "L'onglet de l'école " + ecole + " n'existe pas dans ce classeur. " +
    "Le backend est configuré pour ne créer aucun nouvel onglet."
  );
}

/**
 * Réutilise uniquement les colonnes existantes grâce aux alias.
 * Ne crée aucune colonne et ne modifie aucun en-tête.
 *
 * @return {Object} correspondance cle -> numéro de colonne (base 1)
 */
function synchroniserColonnes_(feuille) {
  const derniereColonne = feuille.getLastColumn();

  if (derniereColonne < 1) {
    throw new Error(
      "L'onglet " + feuille.getName() + " ne contient aucun en-tête en ligne 1."
    );
  }

  const enTetes = feuille
    .getRange(1, 1, 1, derniereColonne)
    .getDisplayValues()[0];

  const correspondance = {};
  const indexNormalises = {};

  enTetes.forEach(function(titre, index) {
    const cleNormalisee = normaliserEntete_(titre);
    if (cleNormalisee && indexNormalises[cleNormalisee] === undefined) {
      indexNormalises[cleNormalisee] = index + 1;
    }
  });

  CHAMPS.forEach(function(champ) {
    const candidats = [champ.titre].concat(champ.aliases || []);

    for (let i = 0; i < candidats.length; i++) {
      const enteteNormalisee = normaliserEntete_(candidats[i]);
      if (indexNormalises[enteteNormalisee] !== undefined) {
        correspondance[champ.cle] = indexNormalises[enteteNormalisee];
        break;
      }
    }
  });

  if (!correspondance.email) {
    throw new Error(
      "Aucune colonne e-mail reconnue dans l'onglet " + feuille.getName() + ". " +
      "Le backend ne crée plus de colonne automatiquement."
    );
  }

  return correspondance;
}

function trouverPremiereLigneVideExistante_(feuille, correspondanceColonnes) {
  const premiereLigneDonnees = 2;
  const derniereLigneDisponible = feuille.getMaxRows();

  if (derniereLigneDisponible < premiereLigneDonnees) {
    throw new Error(
      "Aucune ligne de saisie n'existe dans l'onglet " + feuille.getName() + "."
    );
  }

  const colonnesControle = [
    correspondanceColonnes.reference_dossier,
    correspondanceColonnes.email,
    correspondanceColonnes.nom_complet,
    correspondanceColonnes.nom
  ].filter(Boolean);

  const colonneControle = colonnesControle[0];
  const nombreLignes = derniereLigneDisponible - premiereLigneDonnees + 1;
  const valeurs = feuille
    .getRange(premiereLigneDonnees, colonneControle, nombreLignes, 1)
    .getDisplayValues();

  for (let i = 0; i < valeurs.length; i++) {
    if (!nettoyerValeur_(valeurs[i][0])) {
      return premiereLigneDonnees + i;
    }
  }

  throw new Error(
    "Le tableau de l'onglet " + feuille.getName() +
    " ne contient plus de ligne vide existante. Aucune nouvelle ligne n'a été ajoutée."
  );
}

function insererLigne_(feuille, correspondanceColonnes, valeurs) {
  const numeroLigne = trouverPremiereLigneVideExistante_(
    feuille,
    correspondanceColonnes
  );

  Object.keys(valeurs).forEach(function(cle) {
    const numeroColonne = correspondanceColonnes[cle];
    if (numeroColonne) {
      feuille.getRange(numeroLigne, numeroColonne).setValue(valeurs[cle]);
    }
  });

  return numeroLigne;
}

function estDoublonEmail_(feuille, colonneEmail, email) {
  if (!colonneEmail || !email || feuille.getLastRow() < 2) {
    return false;
  }

  const plage = feuille.getRange(
    2,
    colonneEmail,
    feuille.getLastRow() - 1,
    1
  );

  const resultat = plage
    .createTextFinder(email)
    .matchEntireCell(true)
    .matchCase(false)
    .findNext();

  return resultat !== null;
}

