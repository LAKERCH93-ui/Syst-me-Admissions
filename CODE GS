        "\nModèle : " + fichier.getName() +
        "\nDossier : " + dossier.getName() +
        "\n\nModèle : " + fichier.getUrl() +
        "\nDossier : " + dossier.getUrl(),
      ui.ButtonSet.OK
    );
  } catch (erreur) {
    ui.alert("Configuration invalide", erreur.message, ui.ButtonSet.OK);
  }
}

function auditerConfigurationModelesAdmissions() {
  const ui = SpreadsheetApp.getUi();
  const classeur = SpreadsheetApp.getActiveSpreadsheet();
  const nomFeuille = "AUDIT_MODELES_ADMISSIONS";
  let feuille = classeur.getSheetByName(nomFeuille);

  if (!feuille) {
    feuille = classeur.insertSheet(nomFeuille);
  }

  const lignes = [[
    "DATE AUDIT",
    "ECOLE",
    "FLUX",
    "ID MODELE",
    "STATUT MODELE",
    "NOM MODELE",
    "ID DOSSIER",
    "STATUT DOSSIER",
    "NOM DOSSIER",
    "EXPEDITEUR",
    "REPLY TO"
  ]];

  const maintenant = formaterDate_(new Date());
  let erreurs = 0;
  let valides = 0;

  Object.keys(CONFIG.RESSOURCES_ECOLES).sort().forEach(function(ecole) {
    ["NATIONAL", "INTERNATIONAL"].forEach(function(flux) {
      const ressources = obtenirRessourcesFlux_(ecole, flux);
      let statutModele = "A CONFIGURER";
      let nomModele = "";
      let statutDossier = "A CONFIGURER";
      let nomDossier = "";

      if (estIdConfigure_(ressources.TEMPLATE_ID)) {
        try {
          const fichier = DriveApp.getFileById(ressources.TEMPLATE_ID);
          nomModele = fichier.getName();
          statutModele = fichier.getMimeType() === MimeType.GOOGLE_DOCS
            ? "OK"
            : "ERREUR : PAS UN GOOGLE DOCS";
        } catch (erreurModele) {
          statutModele = "ERREUR : " + erreurModele.message;
        }
      }

      if (estIdConfigure_(ressources.DOSSIER_DRIVE_ID)) {
        try {
          const dossier = DriveApp.getFolderById(ressources.DOSSIER_DRIVE_ID);
          nomDossier = dossier.getName();
          statutDossier = "OK";
        } catch (erreurDossier) {
          statutDossier = "ERREUR : " + erreurDossier.message;
        }
      }

      const ligneValide = statutModele === "OK" && statutDossier === "OK";
      if (ligneValide) valides++;
      else erreurs++;

      lignes.push([
        maintenant,
        ecole,
        flux,
        ressources.TEMPLATE_ID,
        statutModele,
        nomModele,
        ressources.DOSSIER_DRIVE_ID,
        statutDossier,
        nomDossier,
        ressources.NOM_EXPEDITEUR,
        ressources.REPLY_TO
      ]);
    });
  });

  feuille.clearContents();
  feuille.getRange(1, 1, lignes.length, lignes[0].length).setValues(lignes);
  feuille.setFrozenRows(1);
  feuille.autoResizeColumns(1, lignes[0].length);
  feuille.getRange(1, 1, 1, lignes[0].length)
    .setFontWeight("bold")
    .setBackground("#1f4e78")
    .setFontColor("#ffffff");

  ui.alert(
    "Audit terminé",
    "Configurations valides : " + valides +
      "\nConfigurations à corriger : " + erreurs +
      "\n\nConsultez l'onglet " + nomFeuille + ".",
    ui.ButtonSet.OK
  );
}

function formaterDateSimple_(valeur) {
  if (!valeur) return "";

  if (Object.prototype.toString.call(valeur) === "[object Date]") {
    return Utilities.formatDate(
      valeur,
      CONFIG.FUSEAU_HORAIRE,
      "dd/MM/yyyy"
    );
  }

  const texte = nettoyerValeur_(valeur);

  if (/^\d{4}-\d{2}-\d{2}$/.test(texte)) {
    const parties = texte.split("-");
    return parties[2] + "/" + parties[1] + "/" + parties[0];
  }

  return texte;
}

function remplacerVariablesTexte_(modele, variables) {
  let resultat = nettoyerValeur_(modele);

  Object.keys(variables).forEach(function(cle) {
    const motif = new RegExp(
      echapperExpressionReguliere_("{{" + cle + "}}"),
      "g"
    );
    resultat = resultat.replace(motif, nettoyerValeur_(variables[cle]));
  });

  return resultat;
}

function echapperExpressionReguliere_(texte) {
  return String(texte).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function echapperHtml_(texte) {
  return nettoyerValeur_(texte)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}