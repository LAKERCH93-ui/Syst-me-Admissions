function genererLettreAdmission_(candidat, contexte) {
  let copie = null;
  let etape = "initialisation";

  try {
    etape = "lecture du modèle Google Docs";
    const template = executerAvecRelance_(
      function() {
        return DriveApp.getFileById(
          contexte.ressourcesFlux.TEMPLATE_ID
        );
      },
      3,
      800,
      "Accès au modèle Google Docs"
    );

    if (template.getMimeType() !== MimeType.GOOGLE_DOCS) {
      throw new Error(
        "Le modèle n'est pas un Google Docs natif. Type détecté : " +
        template.getMimeType()
      );
    }

    const nomComplet = nettoyerValeur_(candidat.nom_complet) ||
      [candidat.nom, candidat.prenom].filter(Boolean).join(" ") ||
      "CANDIDAT";

    const nomFichier =
      "LETTRE_ADMISSION_" +
      contexte.typeAdmission + "_" +
      contexte.reference +
      "_" +
      nettoyerNomDrive_(nomComplet).replace(/\s+/g, "_");

    etape = "création de la copie du modèle";
    copie = executerAvecRelance_(
      function() {
        const nouvelleCopie = template.makeCopy(
          nomFichier,
          contexte.dossierCandidat
        );
        // Force une lecture réelle de la copie avant de continuer.
        nouvelleCopie.getName();
        return nouvelleCopie;
      },
      4,
      1000,
      "Création de la copie du modèle"
    );

    const documentId = copie.getId();
    Utilities.sleep(1200);

    etape = "ouverture de la copie Google Docs";
    const document = executerAvecRelance_(
      function() {
        return DocumentApp.openById(documentId);
      },
      6,
      1200,
      "Ouverture de la copie Google Docs"
    );

    const remplacements = {
      "{{REFERENCE_DOSSIER}}": contexte.reference,
      "{{REFERENCE}}": contexte.reference,
      "{{NOM_COMPLET}}": nomComplet,
      "{{Noms}}": nomComplet,
      "{{NOM}}": candidat.nom,
      "{{PRENOM}}": candidat.prenom,
      "{{DATE_NAISSANCE}}": formaterDateSimple_(candidat.date_naissance),
      "{{DateNaissance}}": formaterDateSimple_(candidat.date_naissance),
      "{{LIEU_NAISSANCE}}": candidat.lieu_naissance,
      "{{LieuNaissance}}": candidat.lieu_naissance,
      "{{FORMATION}}": candidat.formation,
      "{{Formation}}": candidat.formation,
      "{{CYCLE}}": candidat.cycle,
      "{{NIVEAU}}": candidat.niveau_academique,
      "{{NIVEAU_ACADEMIQUE}}": candidat.niveau_academique,
      "{{DOMAINE}}": candidat.domaine,
      "{{RYTHME}}": candidat.rythme_academique || candidat.rythme,
      "{{RYTHME_ACADEMIQUE}}": candidat.rythme_academique || candidat.rythme,
      "{{CODE_RNCP}}": candidat.code_rncp,
      "{{CAMPUS}}": contexte.campus,
      "{{TYPE_ADMISSION}}": contexte.typeAdmission,
      "{{LIBELLE_TYPE_ADMISSION}}": contexte.typeAdmission === "NATIONAL"
        ? "Admission nationale"
        : "Admission internationale",
      "{{SIGNATURE_REQUISE}}": contexte.typeAdmission === "NATIONAL" ? "OUI" : "NON",
      "{{PROCEDURE_POST_ADMISSION}}": contexte.typeAdmission === "NATIONAL"
        ? "Signature électronique interne par code OTP et signature manuscrite."
        : "Envoi direct de la lettre et poursuite de la procédure internationale.",
      "{{PAYS_RESIDENCE}}": candidat.pays_residence,
      "{{VILLE}}": candidat.ville,
      "{{ADRESSE}}": candidat.adresse,
      "{{EMAIL}}": candidat.email,
      "{{TELEPHONE}}": candidat.telephone,
      "{{ECOLE}}": contexte.ecole,
      "{{Ecole}}": contexte.ecole,
      "{{DATE_DECISION}}": Utilities.formatDate(
