function installerColonnesSignatureInterneDansFeuille_(feuille) {
  if (!feuille || feuille.getLastColumn() < 1) {
    throw new Error("La feuille ne contient pas de ligne d'en-tête.");
  }

  const correspondance = synchroniserColonnes_(feuille);
  const cles = obtenirClesColonnesSignatureInterne_();
  const manquantes = cles.filter(function(cle) {
    return !correspondance[cle];
  });

  if (manquantes.length === 0) {
    return { ajoutees: 0, titres: [] };
  }

  const titres = manquantes.map(function(cle) {
    const champ = CHAMPS.filter(function(item) {
      return item.cle === cle;
    })[0];
    return champ ? champ.titre : cle;
  });

  feuille.getRange(
    1,
    feuille.getLastColumn() + 1,
    1,
    titres.length
  ).setValues([titres]);

  return {
    ajoutees: titres.length,
    titres: titres
  };
}

